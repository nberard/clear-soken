   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::timestamptz AS time, CASE WHEN confiance = 'inconnu' THEN 'inconnu' ELSE (CASE WHEN niveau_thc > 0 THEN 'THC / équivalent' WHEN niveau_max > 0 AND psychoactivite >= 1 THEN 'léger' WHEN niveau_max > 0 THEN 'non psychoactif' ELSE 'rien' END) || CASE WHEN confiance = 'deduit' THEN ' (déduit)' ELSE '' END END AS \"Conso\" FROM conso_quotidien WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
    }
   ],
   "fieldConfig": {
