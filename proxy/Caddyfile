{
	email {$ACME_EMAIL}
}

# --- Clear Soken ---
{$CLEARSOKEN_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Pas de journal d'accès : on ne garde pas les adresses IP des patients.
	log {
		output discard
	}
	reverse_proxy clearsoken:8080
}

# --- Sites optionnels (ex. tableau de bord santé : make health-proxy) ---
import /etc/caddy/sites/*.caddy

