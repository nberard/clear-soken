  {
   "type": "timeseries",
   "title": "Données du jour (écart à ta moyenne 30 j, en écarts-types)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::timestamptz AS time, z_sommeil AS \"Sommeil\", z_pas AS \"Pas\", z_fc AS \"FC repos\", z_vfc AS \"VFC\", z_envoyes AS \"Messages envoyés\", z_nuit AS \"Messages de nuit\" FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
    }
   ],
   "fieldConfig": {
