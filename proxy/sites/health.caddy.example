# --- Tableau de bord santé perso (mint-health) ---
# Activé par : make health-proxy (copie ce fichier en sites/health.caddy)
# Variables dans proxy/.env : HEALTH_HOST, HEALTH_AUTH_USER, HEALTH_AUTH_HASH
{$HEALTH_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
	}
	log {
		output discard
	}

	# Tout l'hôte est derrière un mot de passe (Grafana est en lecture anonyme derrière),
	# sauf l'envoi Health Connect du téléphone, protégé par son propre jeton (HC_INGEST_TOKEN).
	@protected not path /health/api/ingest/*
	basic_auth @protected {
		{$HEALTH_AUTH_USER} {$HEALTH_AUTH_HASH}
	}

	# Envoi Health Connect : uniquement POST, taille limitée
	@ingest path /health/api/ingest/*
	handle @ingest {
		@notpost not method POST
		respond @notpost 405
		request_body {
			max_size 20MB
		}
		uri strip_prefix /health/api
		reverse_proxy mint-health-sync:8765
	}

	redir / /health/
	redir /health /health/

	# Service de synchro : uniquement ses routes. Tout le reste de /health/api/*
	# appartient à Grafana (son API interne : /api/dashboards, /api/folders…).
	@sync path /health/api/auth/start /health/api/auth/callback /health/api/auth/logout /health/api/status /health/api/sync /health/api/healthz
	handle @sync {
		uri strip_prefix /health/api
		reverse_proxy mint-health-sync:8765
	}

	# Grafana (servi sous /health)
	@grafana {
		path /health/*
		not path /health/api/ingest/*
		not path /health/api/auth/start /health/api/auth/callback /health/api/auth/logout /health/api/status /health/api/sync /health/api/healthz
	}
	handle @grafana {
		reverse_proxy mint-health-grafana:3000
	}

	handle {
		respond 404
	}
}
