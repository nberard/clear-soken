    {
      "id": 20,
      "type": "table",
      "title": "Toutes les métriques sur la période",
      "transparent": true,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "healthpg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "healthpg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT metric AS \"Métrique\", round(avg(value)::numeric, 1) AS \"Moyenne\", round(min(value)::numeric, 1) AS \"Min\", round(max(value)::numeric, 1) AS \"Max\", count(*) AS \"Jours\" FROM daily_metrics WHERE $__timeFilter(day::timestamptz) GROUP BY metric ORDER BY metric"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
