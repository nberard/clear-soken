{
  "head-service": {
    "type": "header",
    "description": "Services locaux"
  },
  "api-url": {
    "type": "entry",
    "default": "http://localhost:8765",
    "description": "URL du service de synchro (serveur : https://health.touplitoui.me/health/api)"
  },
  "grafana-url": {
    "type": "entry",
    "default": "http://localhost:3000",
    "description": "URL de Grafana (serveur : https://health.touplitoui.me/health)"
  },
  "dashboard-uid": {
    "type": "entry",
    "default": "google-health",
    "description": "UID du dashboard Grafana"
  },
  "auth-user": {
    "type": "entry",
    "default": "",
    "description": "Identifiant (si le serveur est protégé par mot de passe)"
  },
  "auth-password": {
    "type": "entry",
    "default": "",
    "description": "Mot de passe"
  },
  "head-display": {
    "type": "header",
    "description": "Affichage"
  },
  "panel-metric": {
    "type": "combobox",
    "default": "steps",
    "options": {
      "Pas du jour": "steps",
      "Sommeil de la nuit": "sleep",
      "Rien (icône seule)": "none"
    },
    "description": "Valeur affichée dans la barre"
  },
  "mini-panel-id": {
    "type": "spinbutton",
    "default": 10,
    "min": 1,
    "max": 999,
    "step": 1,
    "units": "",
    "description": "ID du panneau Grafana affiché dans le menu"
  },
  "mini-range": {
    "type": "entry",
    "default": "now-14d",
    "description": "Période du mini-graphique (syntaxe Grafana)"
  },
  "refresh-min": {
    "type": "spinbutton",
    "default": 5,
    "min": 1,
    "max": 120,
    "step": 1,
    "units": "minutes",
    "description": "Rafraîchissement"
  },
  "head-dock": {
    "type": "header",
    "description": "Fenêtre dashboard transparente"
  },
  "dock-width": {
    "type": "spinbutton",
    "default": 900,
    "min": 300,
    "max": 3000,
    "step": 10,
    "units": "px",
    "description": "Largeur"
  },
  "dock-height": {
    "type": "spinbutton",
    "default": 620,
    "min": 200,
    "max": 2000,
    "step": 10,
    "units": "px",
    "description": "Hauteur"
  },
  "dock-opacity": {
    "type": "scale",
    "default": 0.82,
    "min": 0.3,
    "max": 1.0,
    "step": 0.02,
    "description": "Opacité du fond"
  },
  "dock-autoclose": {
    "type": "switch",
    "default": true,
    "description": "Fermer quand la fenêtre perd le focus"
  }
}
