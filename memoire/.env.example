# API pour les casquettes non privées : mistral (hébergé en France) ou anthropic
MEMOIRE_API=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Modèle local pour les casquettes privées (santé mentale) : Ollama sur ton PC,
# joint par un tunnel SSH (voir README). 172.17.0.1 = l'hôte vu depuis Docker.
OLLAMA_URL=http://172.17.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
