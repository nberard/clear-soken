    "uid": "healthpg"
   },
   "transparent": true
  },
  {
   "type": "table",
   "title": "Achats détectés",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT e.at AS \"Quand\", CASE e.source WHEN 'gmail' THEN coalesce(e.detail->>'boutique', 'Gmail') WHEN 'notif' THEN 'Notification' ELSE initcap(e.source) END AS \"Source\", string_agg(coalesce(s.nom, e.substance), ', ' ORDER BY s.psychoactivite DESC) AS \"Molécules\", sum(e.grammes) AS \"Grammes\", max(e.detail->>'total') AS \"Total €\" FROM conso_events e LEFT JOIN conso_substances s ON s.code = e.substance WHERE e.kind = 'achat' AND $__timeFilter(e.at) GROUP BY e.at, e.source, e.ref, e.detail->>'boutique' ORDER BY e.at DESC LIMIT 200"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 9,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "healthpg"
   },
   "transparent": true
  },
  {
   "type": "table",
   "title": "Ce qui va avec ton humeur déclarée (corrélation sur la période)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT 'Sommeil' AS \"Donnée\", round(corr(moral, sommeil)::numeric, 2) AS \"Corrélation\", count(*) FILTER (WHERE moral IS NOT NULL AND sommeil IS NOT NULL) AS \"Jours\" FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'Pas', round(corr(moral, pas)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND pas IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'FC au repos', round(corr(moral, fc_repos)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND fc_repos IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'VFC', round(corr(moral, vfc)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND vfc IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'Conso THC / équivalent', round(corr(moral, conso)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND conso IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'Messages envoyés', round(corr(moral, envoyes)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND envoyes IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) UNION ALL SELECT 'Humeur estimée', round(corr(moral, estime)::numeric, 2), count(*) FILTER (WHERE moral IS NOT NULL AND estime IS NOT NULL) FROM moral_quotidien WHERE $__timeFilter(day::timestamptz)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "pas assez de jours"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "description": "Entre -1 et 1, sur l'échelle -3 (très bas) à +3 (trop haut). Une phase haute et une phase basse peuvent toutes deux baisser le sommeil : une corrélation proche de 0 ne veut pas dire « sans lien ». Il faut une vingtaine de jours notés au minimum.",
   "id": 10,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "healthpg"
   },
   "transparent": true
  }
