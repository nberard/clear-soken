      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "healthpg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (end_time AT TIME ZONE 'Europe/Paris')::date::timestamptz AS time, sum(minutes_deep)/60.0 AS \"Profond\", sum(minutes_light)/60.0 AS \"Léger\", sum(minutes_rem)/60.0 AS \"Paradoxal\" FROM sleep_sessions WHERE is_main IS NOT FALSE AND $__timeFilter(end_time) GROUP BY 1 ORDER BY 1"
        }
