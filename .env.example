# Copier en .env (à côté de docker-compose.yml), puis : make deploy
# Prix des plans : un seul prix de référence par jour, tout le reste est calculé (voir /api/plans).

# Premium, en centimes d'euro par jour : 2 = 0,61 €/mois et 7,30 €/an
PRIX_JOUR_CENTIMES=2
# Essai gratuit de Premium, en jours
ESSAI_JOURS=30
# Remise sur le paiement annuel, en %
REMISE_ANNUELLE_PCT=0
# Prix d'un paquet de cigarettes, pour la comparaison (humoristique) de la page /offres/
PRIX_PAQUET_CENTIMES=1300
