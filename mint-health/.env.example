# --- Google Cloud (voir README, étape 1) ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
PUBLIC_URL=http://localhost:8765

# Scopes demandés (suffixes de https://www.googleapis.com/auth/googlehealth.)
GOOGLE_HEALTH_SCOPES=activity_and_fitness.readonly,health_metrics_and_measurements.readonly,sleep.readonly

# Types agrégés par jour. Un type indisponible est simplement ignoré
# (visible dans le panneau « Journal de synchro » de Grafana).
ROLLUP_TYPES=steps,distance,total-calories,active-minutes,heart-rate,daily-resting-heart-rate,daily-heart-rate-variability,weight
SYNC_SLEEP=true

# --- Synchro ---
TZ=Europe/Paris
SYNC_INTERVAL_MIN=15
BACKFILL_DAYS=90
RECENT_DAYS=3

# --- Mots de passe locaux (change-les) ---
POSTGRES_PASSWORD=change-moi-pg
GRAFANA_DB_PASSWORD=change-moi-ro
GRAFANA_ADMIN_PASSWORD=change-moi-admin

# --- Serveur uniquement (make health-deploy) ---
# Doit être identique à HEALTH_HOST dans proxy/.env
HEALTH_HOST=health.touplitoui.me
