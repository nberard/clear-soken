# Copier en .env (à côté de docker-compose.yml), puis : make deploy
# Prix des plans : un seul prix de référence par jour, tout le reste est calculé (voir /api/plans).

# Premium, en centimes d'euro par jour : 2 = 0,61 €/mois et 7,30 €/an
PRIX_JOUR_CENTIMES=2
# Essai gratuit de Premium, en jours
ESSAI_JOURS=30
# Remise sur le paiement annuel, en %
REMISE_ANNUELLE_PCT=0
# Prix d'un paquet de cigarettes, pour la comparaison (humoristique) de la page /offres/
PRIX_PAQUET_CENTIMES=1300

# Comptes des potes (portail des téléchargements…), sans lien avec les patients : voir README « Comptes des potes ».
# Jeton que les autres services présentent pour vérifier un compte. Créé par make compte-jeton (vide = fermé).
COMPTES_JETON=

# Espace admin (/admin/) : stats Instagram de clearmind-tools, réservées aux comptes avec le rôle admin.
# Clé JSON d'un compte de service Google (rôles BigQuery Data Viewer + BigQuery Job User), posée par make admin-cle.
# Vide = espace admin fermé.
BQ_CLE=
# Projet (vide = celui de la clé), dataset des marts dbt (prod : clearmind_or), région
BQ_PROJET=
BQ_DATASET=clearmind_or
BQ_LOCATION=EU

# Espace admin, page /admin/sessions/ : index des sessions Claude Code, envoyé par une session Claude
# (scripts/sessions-claude-index.py). Jeton d'au moins 32 caractères, créé par make claude-jeton (vide = import fermé).
CLAUDE_INDEX_JETON=

# Espace admin, page /admin/opportunites/ : opportunités pro relevées dans Gmail par une session Claude.
# Jeton d'import d'au moins 32 caractères (vide = CLAUDE_INDEX_JETON). Relevé et suivi : à côté des comptes.
OPPORTUNITES_JETON=
