            "uid": "healthpg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT at AS \"Heure\", data_type AS \"Type\", CASE WHEN ok THEN '✓' ELSE '✗' END AS \"OK\", rows AS \"Lignes\", message AS \"Message\" FROM sync_log ORDER BY at DESC LIMIT 50"
