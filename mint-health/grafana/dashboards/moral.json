  },
  {
   "type": "timeseries",
   "title": "Niveau par substance (1 un peu · 2 moyen · 3 beaucoup)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT c.day::timestamptz AS time, coalesce(s.nom, c.substance) AS metric, max(c.niveau) AS value FROM conso_jour_substance c LEFT JOIN conso_substances s ON s.code = c.substance WHERE $__timeFilter(c.day::timestamptz) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 3,
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      },
      "barAlignment": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7,
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "healthpg"
   },
   "transparent": true
  },
  {
   "type": "timeseries",
   "title": "Composantes de l'indice (écart à ta moyenne 30 j, en écarts-types)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::timestamptz AS time, z_sommeil AS \"Sommeil\", z_pas AS \"Pas\", z_fc AS \"FC repos (inversée)\", z_vfc AS \"VFC\", z_conso AS \"Conso (inversée)\" FROM moral_quotidien WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": -3,
     "max": 3,
     "custom": {
