# Copier en .env puis adapter
ACME_EMAIL=ton-email@exemple.fr   # pour les alertes Let's Encrypt
CLEARSOKEN_DOMAIN=clearsoken.touplitoui.me

# --- Optionnel : tableau de bord santé perso (mint-health), voir mint-health/README.md ---
HEALTH_HOST=health.touplitoui.me
HEALTH_AUTH_USER=nico
# Hash bcrypt : docker run --rm caddy:2 caddy hash-password --plaintext 'ton-mot-de-passe'
# Garde les apostrophes : sans elles, docker compose interprète les « $ » du hash.
HEALTH_AUTH_HASH='$2a$14$remplace-moi'

# --- Optionnel : rapports Clearmind (site privé), voir README « Rapports Clearmind » ---
RAPPORTS_HOST=rapports.touplitoui.me
RAPPORTS_AUTH_USER=nico
# Même méthode que HEALTH_AUTH_HASH (garde les apostrophes)
RAPPORTS_AUTH_HASH='$2a$14$remplace-moi'
# Dossier du serveur où clearmind-tools dépose les rapports (python site_rapports.py publier)
RAPPORTS_DIR=/home/nico/clearmind-rapports
