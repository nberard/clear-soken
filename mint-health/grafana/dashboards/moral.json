  {
   "type": "state-timeline",
   "title": "Conso par jour",
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "healthpg"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::timestamptz AS time, CASE WHEN confiance = 'inconnu' THEN 'inconnu' ELSE (CASE WHEN niveau_thc > 0 THEN 'THC / équivalent' WHEN niveau_max > 0 AND psychoactivite >= 1 THEN 'léger' WHEN niveau_max > 0 THEN 'non psychoactif' ELSE 'rien' END) || CASE WHEN confiance = 'deduit' THEN ' (déduit)' ELSE '' END END AS \"Conso\" FROM conso_quotidien WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "THC / équivalent": {
         "color": "#D9534F",
         "index": 0
        }
       }
      },
      {
       "type": "value",
       "options": {
        "THC / équivalent (déduit)": {
         "color": "rgba(217,83,79,0.45)",
         "index": 1
        }
       }
      },
      {
       "type": "value",
       "options": {
        "léger": {
         "color": "#C9A43A",
         "index": 2
        }
       }
      },
      {
       "type": "value",
       "options": {
        "léger (déduit)": {
         "color": "rgba(201,164,58,0.45)",
         "index": 3
        }
       }
      },
      {
       "type": "value",
       "options": {
        "non psychoactif": {
         "color": "#4C8F6A",
         "index": 4
        }
       }
      },
      {
       "type": "value",
       "options": {
        "non psychoactif (déduit)": {
         "color": "rgba(76,143,106,0.45)",
         "index": 5
        }
       }
      },
      {
       "type": "value",
       "options": {
        "rien": {
         "color": "#73BF69",
         "index": 6
        }
       }
      },
      {
       "type": "value",
       "options": {
        "inconnu": {
         "color": "#3A3F48",
         "index": 7
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
