# --- Rapports Clearmind (site privé, perso) ---
# Activé par : make rapports-proxy (copie ce fichier en sites/rapports.caddy)
# Variables dans proxy/.env : RAPPORTS_HOST, RAPPORTS_AUTH_USER, RAPPORTS_AUTH_HASH, RAPPORTS_DIR
# Contenu envoyé depuis le PC par clearmind-tools (python site_rapports.py publier) : seulement des rapports
# HTML/PDF, jamais les exports bruts. Sans lien avec l'appli patients.
{$RAPPORTS_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cache-Control "private, no-store"
	}
	log {
		output discard
	}

	# Tout le site est derrière un mot de passe (le QR code mène à la page de connexion)
	basic_auth {
		{$RAPPORTS_AUTH_USER} {$RAPPORTS_AUTH_HASH}
	}

	root * /srv/rapports
	file_server
}
