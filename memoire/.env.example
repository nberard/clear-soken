# Modèle pour les casquettes non privées :
#   ollama    = tout en local sur ton PC (aucune clé, rien ne sort de chez toi)
#   mistral   = API Mistral (hébergée en France)
#   anthropic = API Claude
MEMOIRE_API=ollama
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Modèle local pour les casquettes privées (santé mentale) : Ollama sur ton PC,
# joint par un tunnel SSH (voir README). 172.17.0.1 = l'hôte vu depuis Docker.
OLLAMA_URL=http://172.17.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Domaine public (le serveur MCP HTTP n'accepte que cet en-tête Host)
MEMOIRE_HOST=memoire.touplitoui.me
# 1 = les casquettes privées deviennent visibles par MCP (donc lues par Claude/Anthropic)
MEMOIRE_MCP_PRIVE=0
